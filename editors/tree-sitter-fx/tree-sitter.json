{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "fx",
      "camelcase": "Fx",
      "title": "fx-50FH II PRGM",
      "scope": "source.fx",
      "file-types": [
        "fx"
      ],
      "injection-regex": "^fx$",
      "class-name": "TreeSitterFx"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the CASIO fx-50FH II PRGM language",
    "authors": [
      {
        "name": "wqLouis"
      }
    ],
    "links": {
      "repository": "https://github.com/wqLouis/casio-fx50fh2-emulator"
    }
  }
}
