{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CASIO fx-50FH II C-like",
  "scopeName": "source.fxc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#numbers" },
    { "include": "#physical-constants" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#keywords" },
    { "include": "#identifiers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.fxc"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.fxc"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(?i)^\\s*(#mode)\\s*=?\\s*([A-Za-z0-9_-]+)",
          "captures": {
            "1": { "name": "keyword.control.directive.fxc" },
            "2": { "name": "constant.language.mode.fxc" }
          }
        },
        {
          "match": "^\\s*(#include)\\s*(\")([^\"]*)(\")",
          "captures": {
            "1": { "name": "keyword.control.directive.fxc" },
            "2": { "name": "punctuation.definition.string.begin.fxc" },
            "3": { "name": "string.quoted.double.include.fxc" },
            "4": { "name": "punctuation.definition.string.end.fxc" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_.])[0-9]+(?:\\.[0-9]*)?(?:[eE][+-]?[0-9]+)?(?![A-Za-z0-9_])",
          "name": "constant.numeric.fxc"
        },
        {
          "match": "(?<![A-Za-z0-9_.])\\.[0-9]+(?:[eE][+-]?[0-9]+)?(?![A-Za-z0-9_])",
          "name": "constant.numeric.fxc"
        }
      ]
    },
    "physical-constants": {
      "patterns": [
        {
          "match": "\\b(phys)\\s*(\\.)\\s*(mumu|alpha|sigma|hbar|Rinf|phi0|eps0|mmu|muN|muB|mup|mue|mun|λcp|λcn|atm|C0|C1|C2|G0|Z0|NA|Vm|tK|a0|mu0|lcp|mμ|μN|μB|μp|μe|μn|μμ|ε0|μ0|φ0|R∞|γp|λc|mp|mn|me|lc|gp|re|eq|u|k|F|R|g|G|h|e|i|π|ħ|α|σ)(?![A-Za-z0-9_.])",
          "captures": {
            "1": { "name": "entity.name.namespace.fxc" },
            "2": { "name": "punctuation.accessor.fxc" },
            "3": { "name": "constant.language.physical.fxc" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "(?<![A-Za-z_0-9])(?:pi|e)(?![A-Za-z0-9_])",
          "name": "constant.language.fxc"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "(?<![A-Za-z_0-9])(?:sqrt|cbrt|abs|sin|cos|tan|asin|acos|atan|sinh|cosh|tanh|asinh|acosh|atanh|log|ln|rnd|input)(?![A-Za-z0-9_])",
          "name": "support.function.fxc"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<![A-Za-z_0-9])(?:let|if|else|while|for|break|goto|label|print|phys)(?![A-Za-z0-9_])",
          "name": "keyword.control.fxc"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.fxc"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(?:\\*\\*|==|!=|<=|>=)",
          "name": "keyword.operator.fxc"
        },
        {
          "match": "[+\\-*/^=<>(){};,.]",
          "name": "keyword.operator.fxc"
        }
      ]
    }
  }
}
