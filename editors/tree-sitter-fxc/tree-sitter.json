{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "fxc",
      "camelcase": "Fxc",
      "title": "fx-50FH II C-like",
      "scope": "source.fxc",
      "file-types": [
        "fxc"
      ],
      "injection-regex": "^fxc$",
      "class-name": "TreeSitterFxc"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for the CASIO fx-50FH II C-like language",
    "authors": [
      {
        "name": "wqLouis"
      }
    ],
    "links": {
      "repository": "https://github.com/wqLouis/casio-fx50fh2-emulator"
    }
  }
}
