// Factorial — the same example as examples/factorial.fx, but in C-like form.
// Transpile and run with:  fx50 run examples/factorial.fxc
fn main() {
    let n = input();
    let result = 1;
    for (let i = 1; i <= n; i = i + 1) {
        result = result * i;
    }
    print(result);
}

// The cases travel with the program: `fx50 test examples/factorial.fxc`.
#tests = [
  { "name": "5! = 120", "input": [5], "output": ["120"] },
  { "name": "1! = 1", "input": [1], "output": ["1"] },
  { "name": "0! = 1", "input": [0], "output": ["1"] },
  { "name": "10! = 3628800", "input": [10], "output": ["3628800"] },
  { "name": "no input given is an Argument ERROR", "input": [], "error": "Argument ERROR" }
];
