// Quadratic formula (real roots) in C-like form.
// fx50 run examples/quadratic.fxc   with inputs 1, -3, 2
fn main() {
    let a = input();
    let b = input();
    let c = input();
    let discriminant = b * b - 4 * a * c;

    if (discriminant >= 0) {
        print((-b + sqrt(discriminant)) / (2 * a));
        print((-b - sqrt(discriminant)) / (2 * a));
    } else {
        print(discriminant);
    }
}

#tests = [
  { "name": "x^2 - 3x + 2 has roots 2 and 1", "input": [1, -3, 2], "output": ["2", "1"] },
  { "name": "x^2 - 1 has roots 1 and -1", "input": [1, 0, -1], "output": ["1", "-1"] },
  { "name": "x^2 + 1 has no real roots, so it prints the discriminant",
    "input": [1, 0, 1], "output": ["-4"] }
];
