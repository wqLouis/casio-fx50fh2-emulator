// Determinant of a 3x3 matrix, read row by row from the prompt.
//
//   | a b c |
//   | d e f |      det = a(ei - fh) - b(di - fg) + c(dh - eg)
//   | g h i |
//
// Nine values will not fit in seven memories, so the six terms are grouped by
// the third row:
//
//   det = g*(bf - ce) + h*(cd - af) + i*(ae - bd)
//         \___________/  \___________/  \___________/
//            g_coef         h_coef         i_coef
//
// Each coefficient needs only the first two rows. So the first row holds three
// memories, and the second row is folded into three accumulators as it arrives
// — six values live at once, never nine. Once the coefficients are complete the
// first row is dead, and `free` hands those memories to the third row.
//
// `free` emits nothing; it just tells the allocator a memory is reusable. This
// program is tight: it uses all seven memories at its peak, so each second-row
// entry is released as soon as it has been folded in. Freeing one too late and
// the next `let` reports "no free memory" naming the holders — `fx50 regs`
// shows the plan.
//
//   fx50 regs  examples/determinant.fxc
//   fx50 test  examples/determinant.fxc
//   printf '1\n2\n3\n4\n5\n6\n7\n8\n10\n' | fx50 run examples/determinant.fxc

#mode COMP

// Row 1: the three entries every coefficient is built from.
let m11 = input();
let m12 = input();
let m13 = input();

// Row 2, folded in one entry at a time. After each pair of products is
// accumulated, that entry is finished with.
let m21 = input();
let h_coef = m13 * m21;       // cd   (a partial sum; `- af` comes with m23)
let i_coef = -m12 * m21;      // -bd  (`+ ae` comes with m22)
free m21;

let m22 = input();
let g_coef = -m13 * m22;      // -ce  (`+ bf` comes with m23)
i_coef = i_coef + m11 * m22;  // completes i_coef = ae - bd
free m22;

let m23 = input();
g_coef = g_coef + m12 * m23;  // completes g_coef = bf - ce
h_coef = h_coef - m11 * m23;  // completes h_coef = cd - af
free m23;

// The first row was only ever used to build the coefficients, so release those
// three memories for the third row.
free m11;
free m12;
free m13;

// Row 3: each entry scales its coefficient and adds into the running total.
let m31 = input();
let det = m31 * g_coef;
free m31;

let m32 = input();
det = det + m32 * h_coef;
free m32;

let m33 = input();
det = det + m33 * i_coef;

print(det);

#tests = [
  { "name": "the matrix from the header comment",
    "input": [1, 2, 3, 4, 5, 6, 7, 8, 10], "output": ["-3"] },
  { "name": "the identity has determinant 1",
    "input": [1, 0, 0, 0, 1, 0, 0, 0, 1], "output": ["1"] },
  { "name": "a singular matrix has determinant 0",
    "input": [1, 2, 3, 4, 5, 6, 7, 8, 9], "output": ["0"] },
  { "name": "triangular: the product of the diagonal",
    "input": [2, 9, 9, 0, 3, 9, 0, 0, 4], "output": ["24"] },
  { "name": "a zero row makes it singular",
    "input": [1, 2, 3, 0, 0, 0, 7, 8, 10], "output": ["0"] },
  { "name": "swapping two rows flips the sign",
    "input": [4, 5, 6, 1, 2, 3, 7, 8, 10], "output": ["3"] },
  { "name": "scaling a row scales the determinant",
    "input": [2, 4, 6, 4, 5, 6, 7, 8, 10], "output": ["-6"] },
  { "name": "negative entries",
    "input": [-1, 2, 3, 4, -5, 6, 7, 8, -10], "output": ["363"] },
  { "name": "all zeros",
    "input": [0, 0, 0, 0, 0, 0, 0, 0, 0], "output": ["0"] },
  { "name": "fractions survive",
    "input": [0.5, 0, 0, 0, 0.5, 0, 0, 0, 0.5], "output": ["0.125"] },
  { "name": "determinant is linear in one entry: +1 on m33 adds i_coef = -3",
    "input": [1, 2, 3, 4, 5, 6, 7, 8, 20], "output": ["-33"] },
  { "name": "a large entry",
    "input": [1, 2, 3, 4, 5, 6, 7, 8, 26], "output": ["-51"] }
];
