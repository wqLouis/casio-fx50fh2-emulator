// Pulls in a library of functions at transpile time.
//
// `fx50 build examples/include.fxc` inlines each `#include` before compiling, so
// the calculator only ever sees one flat program. Removing the files under
// `examples/lib/` stops this building — that is the point of the example.
//
// `#include` is a **top-level** directive: a library contributes `fn`
// definitions to be *called*, not statements spliced into a body. Putting the
// include inside `main` is an error, which is what keeps every file's meaning
// local to itself — `squares.fxc` cannot see this file's `n`, and this file
// cannot be surprised by a name the library happens to define.

#include "lib/squares.fxc"

fn main() {
    let n = input();
    print(square_plus_one(n));
}

#tests = [
  { "name": "5^2 + 1 = 26", "input": [5], "output": ["26"] },
  { "name": "0^2 + 1 = 1", "input": [0], "output": ["1"] },
  { "name": "(-3)^2 + 1 = 10", "input": [-3], "output": ["10"] }
];
