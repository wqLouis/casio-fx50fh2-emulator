// Compile-time data, constants, and the optimiser.
//
// `#data` parses JSON while transpiling, so its values become plain literals in
// the program and occupy none of the calculator's seven memories. `const` does
// the same for a fixed expression. Nothing here needs a memory at all, and the
// optimiser proves it: each `value` is used once, so its store is removed and
// the number is displayed directly.
//
//   fx50 build examples/compiletime.fxc
//   fx50 build --no-optimize examples/compiletime.fxc   # the raw translation
//   fx50 size  examples/compiletime.fxc                 # and what it saves
//   fx50 test  examples/compiletime.fxc
//
// `#mode` is a whole-program directive, so it comes first; `#data` may sit
// anywhere.

#mode COMP

// A JSON value written straight into the program. It could equally be
// `#data config = "config.json";` to read a file next to this one.
#data config = { "base": 2, "offsets": [10, 20, 30] };

// A fixed value, inlined wherever it is used; it needs no memory.
const scale = config.base;

fn main() {
    // `20◢` — the data path and the const both fold, and `value` is read once,
    // so storing it would cost three keys to no purpose.
    let value = config.offsets[0] * scale;
    print(value);

    // `free` releases a memory for a later variable to reuse. It is a no-op
    // here, because the optimiser already removed the store — but it is what
    // makes a program with seven *live* values fit, which is the case that
    // matters: see examples/determinant.fxc, where every one of the seven
    // memories is in use at once.
    free value;
    let value = config.offsets[2] * scale;
    print(value);
}

// The cases travel with the program: `fx50 test examples/compiletime.fxc`.
#tests = [
  { "name": "offsets 0 and 2, scaled by base 2", "output": ["20", "60"] }
];
