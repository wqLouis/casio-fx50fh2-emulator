{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun run check:wasm && vite dev",
		"build": "bun run build:examples && bun run check:wasm && vite build",
		"preview": "vite preview",
		"build:wasm": "bun scripts/build-wasm.ts",
		"build:examples": "bun scripts/bundle-examples.ts",
		"check:wasm": "bun scripts/check-wasm.ts",
		"test": "bun run build:examples && bun test",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.4",
		"@codemirror/view": "^6.43.11",
		"@lezer/highlight": "^1.2.3",
		"@lucide/svelte": "^1.45.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.2",
		"bits-ui": "^2.19.2",
		"codemirror": "^6.0.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
